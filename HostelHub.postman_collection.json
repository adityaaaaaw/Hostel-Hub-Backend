                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "  pm.expect(pm.response.json().success).to.be.true;",
                  "});",
                  "",
                  "pm.test('Room data is returned', function () {",
                  "  const room = pm.response.json().data;",
                  "  pm.expect(room.name).to.equal('301');",
                  "  pm.expect(room.block).to.equal('C');",
                  "  pm.expect(room.is_deleted).to.equal(0);",
                  "});",
                  "",
                  "// Save the new room's ID for use in other requests",
                  "const newId = pm.response.json().data.id;",
                  "pm.collectionVariables.set('roomId', newId);",
                  "console.log('Saved roomId:', newId);"
                ]
              }
            }
