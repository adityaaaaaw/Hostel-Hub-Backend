{
  "info": {
    "name": "HostelHub API Collection",
    "_postman_id": "hostelhub-api-collection-v1",
    "description": "Complete API collection for HostelHub — a backend system for managing hostel rooms, residents, and allotments.\n\nBase URL: http://localhost:3000\n\nFolders:\n  🚪 Rooms       — 6 endpoints (CRUD + soft delete + restore)\n  👤 Residents   — 3 endpoints\n  🔗 Allotments  — 4 endpoints (with SQL JOIN responses)\n\nAll endpoints verified against source code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Base URL of the HostelHub API server"
    },
    {
      "key": "roomId",
      "value": "1",
      "type": "string",
      "description": "ID of a room to use in single-room requests. Update after creating a room."
    },
    {
      "key": "residentId",
      "value": "1",
      "type": "string",
      "description": "ID of a resident to use in single-resident requests."
    },
    {
      "key": "allotmentId",
      "value": "1",
      "type": "string",
      "description": "ID of an allotment. Update after POST /allotments."
    }
  ],
  "item": [
    {
      "name": "🚪 Rooms",
      "description": "CRUD operations for hostel rooms.\nSoft-delete is used instead of permanent deletion to preserve allotment history.",
      "item": [
        {
          "name": "GET All Rooms",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"]
            },
            "description": "Returns all active rooms (is_deleted = 0).\n\nOptionally filter by block:\n  GET /rooms?block=A"
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Response is JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});",
                  "",
                  "pm.test('success is true', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.success).to.be.true;",
                  "});",
                  "",
                  "pm.test('data is an array', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('count matches data length', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.count).to.equal(body.data.length);",
                  "});",
                  "",
                  "// Auto-save first room ID into collection variable",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.length > 0) {",
                  "  pm.collectionVariables.set('roomId', body.data[0].id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET All Rooms — Filter by Block",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms?block=A",
              "host": ["{{baseUrl}}"],
              "path": ["rooms"],
              "query": [
                {
                  "key": "block",
                  "value": "A",
                  "description": "Filter rooms by block name (case-insensitive)"
                }
              ]
            },
            "description": "Returns only rooms in the specified block. The filter is case-insensitive (?block=a and ?block=A return the same results)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('All rooms belong to Block A', function () {",
                  "  const body = pm.response.json();",
                  "  body.data.forEach(function (room) {",
                  "    pm.expect(room.block.toUpperCase()).to.equal('A');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET Room by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/rooms/{{roomId}}",
              "host": ["{{baseUrl}}"],
              "path": ["rooms", "{{roomId}}"]
            },
            "description": "Returns a single active room by its ID.\nReturns 404 if the room doesn't exist or is soft-deleted."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Room has id, name, block, is_deleted', function () {",
                  "  const room = pm.response.json().data;",
                  "  pm.expect(room).to.have.property('id');",
                  "  pm.expect(room).to.have.property('name');",
                  "  pm.expect(room).to.have.property('block');",
                  "  pm.expect(room).to.have.property('is_deleted');",
                  "});",
                  "",
                  "pm.test('is_deleted is 0 (room is active)', function () {",
                  "  pm.expect(pm.response.json().data.is_deleted).to.equal(0);",
                  "});"
                ]
              }
            }
          ]
        },
